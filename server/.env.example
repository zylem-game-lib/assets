# Cloudflare account that owns the R2 bucket. Found at the top of the R2 page
# in the Cloudflare dashboard.
R2_ACCOUNT_ID=

# R2 API token credentials (S3-compatible). Create one in:
# Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create API token.
# The token must be scoped to the bucket below with Object Read & Write.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Name of the bucket that backs the CDN.
R2_BUCKET=zylem-assets

# Public CDN base URL. The bucket should be attached to this custom domain
# under R2 -> <bucket> -> Settings -> Custom Domains. No trailing slash.
PUBLIC_BASE_URL=https://assets.zylem.cloud

# Shared bearer token used to authenticate uploads. Generate with:
#   openssl rand -hex 32
# Anyone with this token can upload to the bucket, so treat it like a secret.
API_KEY=

# Optional: max upload size in megabytes. Defaults to 100 if unset.
MAX_UPLOAD_MB=100

# Optional: HTTP listen port. Render sets this automatically; default is 8080.
PORT=8080
